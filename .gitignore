# ------------------------------------
# Repository-wide ignores
# ------------------------------------

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml

# Env / secrets
.env
.env.*
!.env.example

# Logs / runtime
*.log
*.pid
*.out
*.err
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node / Next.js
node_modules/
**/node_modules/
.next/
**/.next/
out/
**/out/
dist/
**/dist/
coverage/
**/coverage/
.vercel/
**/.vercel/

# Java / Maven
.m2/
**/target/
*.class

# Temp/cache
.tmp/
*.tmp

# Generated documentation artifacts
SYSTEMATIC_DOCUMENTATION_SCAN_*.md
generate_systematic_doc.ps1
